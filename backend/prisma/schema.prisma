generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Rating {
  id          Int    @id @default(autoincrement())
  code        String
  description String
  games       Game[]
}

model Platform {
  id    Int    @id @default(autoincrement())
  name  String
  games Game[]
}

model Genre {
  id    Int    @id @default(autoincrement())
  name  String // Contoh: "RPG", "MOBA", "Action"
  games Game[]
}

model Game {
  id          Int    @id @default(autoincrement())
  title       String
  description String
  developer   String
  publisher   String
  releaseDate String
  logoUrl     String
  galleryUrls String

  evolutionTitle String
  evolutionDesc  String

  tipsWaktuLayarTitle String
  tipsWaktuLayarDesc  String

  tipsPembayaranTitle String
  tipsPembayaranDesc  String

  tipsFiturChatTitle String?
  tipsFiturChatDesc  String?

  tipsInteraksiTitle String?
  tipsInteraksiDesc  String?

  saranPsikologis String

  ratingId Int?
  rating   Rating? @relation(fields: [ratingId], references: [id])

  platforms Platform[]
  genres    Genre[]
}
